{
  "name": "@caidazi/dsh-boards",
  "version": "0.1.1",
  "description": "财搭子研究看板：存储产业、AI 基建回报与 PCB/CCL 兑现跟踪，接入财搭子 MCP。",
  "type": "module",
  "license": "MIT",
  "main": "./src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/host.js",
    "src/data.js",
    "src/boards.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@caidazi/mcp": "0.2.10",
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
