{
  "name": "@caidazi/dsh-boards",
  "version": "0.3.2",
  "description": "财搭子研究看板：存储、AI基建、PCB/CCL及美国政策与数据中心，接入财搭子 MCP。",
  "type": "module",
  "license": "MIT",
  "main": "./src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/host.js",
    "src/data.js",
    "src/boards.js",
    "src/market.js",
    "src/research.js",
    "src/publication.js",
    "src/synthesis.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-connection"
      ]
    },
    "catalog": {
      "category": "tool",
      "summary": {
        "en": "Source-backed research boards for memory, AI infrastructure, PCB/CCL and US data-center policy, with Caidazi MCP market data and shared research updates.",
        "zh": "财搭子研究看板，跟踪存储、AI基建、PCB/CCL与美国数据中心政策，接入财搭子MCP行情、资料和共享研究更新。"
      },
      "capabilities": [
        "webserver",
        "client",
        "credentials",
        "mcp",
        "skills"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@caidazi/mcp": "0.2.10",
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markthc/dsh-caidazi-boards.git"
  },
  "homepage": "https://github.com/markthc/dsh-caidazi-boards#readme",
  "bugs": {
    "url": "https://github.com/markthc/dsh-caidazi-boards/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "caidazi",
    "investment-research",
    "finance",
    "dashboard"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
